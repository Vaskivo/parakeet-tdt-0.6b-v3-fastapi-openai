# ---------------------------------------------------------------------------
# Parakeet TDT 0.6B v3 — example environment configuration
# Copy to `.env` (or export in your shell) and edit before exposing the
# service on an untrusted network.
# ---------------------------------------------------------------------------

# ===========================================================================
# Authentication (API + UI)
# ===========================================================================
# By default the server is OPEN (no credentials configured) — convenient for
# local and trusted deployments. Configure one or more credentials to require
# authentication on every route EXCEPT /health and /healthz (which stay open
# for orchestrators and the Docker HEALTHCHECK).
#
# You may configure any combination — none (open), API_KEY only (clients),
# UI_USER+UI_PASSWORD only (browser), or both. Each credential is
# independent and validated against the store matching its scheme; a
# credential with no matching configured store is rejected (no fallback).

# API key for authenticating programmatic requests (OpenAI SDK, cURL, ...).
# When set, clients may send it via either:
#   Authorization: Bearer <key>
#   X-API-Key: <key>
# WARNING: when binding PARAKEET_HOST=0.0.0.0 on an untrusted network, set
# API_KEY to a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=change-me-to-a-long-random-secret

# Browser UI credentials (HTTP Basic auth). Set BOTH to let a human log in to
# the web UI (/, /docs, /redoc, /openapi.json, /parakeet.png, /status,
# /metrics) via the
# browser's native login dialog. Send as:
#   Authorization: Basic <base64(user:password)>
# Independent of API_KEY: configure either, both, or neither. When both are
# set, browsers use Basic and API clients use Bearer/X-API-Key, each valid on
# its own. Setting UI_USER without UI_PASSWORD logs a warning and leaves
# Basic auth disabled (no silent weakening).
# UI_USER=admin
# UI_PASSWORD=change-me

# ===========================================================================
# Network
# ===========================================================================
# Host to bind. Use 0.0.0.0 for all interfaces (default).
PARAKEET_HOST=0.0.0.0
# TCP port for the API (1–65535). Default 5092.
PARAKEET_PORT=5092
# Uvicorn worker count. Keep 1 on a single GPU unless you have VRAM for one
# full model per worker.
PARAKEET_UVICORN_WORKERS=1
LOG_LEVEL=INFO

# ===========================================================================
# Models / device
# ===========================================================================
# Local model cache directory (HuggingFace hub cache).
# PARAKEET_MODELS_DIR=./models
# Device selection: auto | true | false
PARAKEET_USE_GPU=auto
# Default model: one of parakeet-tdt-0.6b-v3 | istupakov/parakeet-tdt-0.6b-v3-onnx | grikdotnet/parakeet-tdt-0.6b-fp16
PARAKEET_DEFAULT_MODEL=istupakov/parakeet-tdt-0.6b-v3-onnx
PARAKEET_GPU_DEVICE_ID=0

# ===========================================================================
# Batching / concurrency (GPU micro-batching)
# ===========================================================================
PARAKEET_BATCHED=1
PARAKEET_MAX_BATCH_SIZE=4
PARAKEET_BATCH_WINDOW_MS=4
PARAKEET_INFER_WORKERS=4
PARAKEET_AUDIO_WORKERS=8

# ===========================================================================
# Chunking / VAD
# ===========================================================================
PARAKEET_CHUNK_TARGET_SEC=60
PARAKEET_CHUNK_MAX_SEC=75
PARAKEET_CHUNK_MIN_SEC=20
PARAKEET_VAD_THRESHOLD=0.5
PARAKEET_VAD_MIN_SILENCE_MS=400
PARAKEET_VAD_SPEECH_PAD_MS=120

# ===========================================================================
# Limits
# ===========================================================================
PARAKEET_MAX_UPLOAD_BYTES=268435456
PARAKEET_MAX_BATCH_FILES=16
PARAKEET_MAX_BATCH_BYTES=536870912
PARAKEET_MAX_AUDIO_SECONDS=7200
PARAKEET_MAX_REQUEST_CHUNKS=512
PARAKEET_FFMPEG_TIMEOUT_SEC=180

# ===========================================================================
# CPU / ONNX Runtime threading
# ===========================================================================
PARAKEET_ORT_INTRA_THREADS=1
PARAKEET_ORT_INTER_THREADS=1
